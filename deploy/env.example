# /etc/nesstech-workana/env — lido pelo systemd (EnvironmentFile).
# Permissão recomendada: root:root 0600 (contém a chave do WAHA).

# Painel: deixe em 127.0.0.1 e acesse por túnel SSH
#   ssh -L 4173:127.0.0.1:4173 usuario@servidor   → http://127.0.0.1:4173
PORT=4173
HOST=127.0.0.1

# Fuso usado no teto diário de envios e nos logs
TZ=America/Sao_Paulo

# Banco local, sessão do navegador e diagnósticos (fora da pasta do código,
# para um redeploy nunca tocar nesses dados)
WORKANA_DATA_DIR=/var/lib/nesstech-workana/data

# Desbloqueio automático do cofre ao reiniciar o serviço. O arquivo contém só a
# senha mestra (root:workana 0640). Deixe comentado para desbloquear sempre
# manualmente pelo painel — mas aí nada roda até alguém desbloquear.
WORKANA_MASTER_PASSWORD_FILE=/etc/nesstech-workana/master-password

# WAHA rodando neste mesmo servidor
WAHA_URL=http://127.0.0.1:3000
# Mesmo valor de WAHA_API_KEY configurado no container do WAHA (vazio se não usa)
WAHA_API_KEY=
WAHA_SESSION=default
