[Unit]
Description=Nesstech Workana - painel de propostas + avisos via WAHA
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=workana
Group=workana
WorkingDirectory=/opt/nesstech-workana
EnvironmentFile=/etc/nesstech-workana/env
Environment=NODE_ENV=production
# O Workana bloqueia Chromium headless (Cloudflare), então o navegador roda
# como janela normal dentro de um display virtual (Xvfb).
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1366x900x24 -nolisten tcp" __NODE_BIN__ server/index.js
Restart=on-failure
RestartSec=15
TimeoutStopSec=30

# Endurecimento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
